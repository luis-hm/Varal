// Diagnostic harness only: expected failures until COR-07 is implemented.
import { fireEvent, screen } from "@testing-library/react";
import { afterEach, beforeEach, expect, test, vi } from "vitest";
import { GrupoPagina } from "@/components/groups/grupo-pagina";
import { ContasPagina } from "@/components/bills/contas-pagina";
import { json, renderComSessao } from "@/components/bills/teste-sessao";

const router = { push: vi.fn(), replace: vi.fn(), refresh: vi.fn() };
let busca = "mes=2026-11";
vi.mock("next/navigation", () => ({ useRouter: () => router, useSearchParams: () => new URLSearchParams(busca) }));
const grupo = { id: "g1", nome: "Diagnóstico", meu_papel: "admin", janela_alerta_dias: 3, membros: [], casas: [] };
const resumo = { mes: "2026-11", total_centavos: 10000, valores_indefinidos_qtd: 0, qtd: 1, pagas_qtd: 0, vencidas_qtd: 0, vence_qtd: 0, janela_alerta_dias: 3, atencao: [], por_casa: [] };
const lista = { mes: "2026-11", total_centavos: 0, valores_indefinidos_qtd: 0, itens: [], contagens: { todas: 0, a_pagar: 0, vencidas: 0, pagas: 0, canceladas: 0 }, opcoes: { casas: [], pagadores: [], sem_pagador: false, ex_membro: false } };
beforeEach(() => { busca = "mes=2026-11"; });
afterEach(() => { vi.unstubAllGlobals(); vi.clearAllMocks(); });
function respostas(comCasa = false) {
  vi.stubGlobal("fetch", vi.fn(async (url: string) => {
    if (url === "/api/grupos/g1/") return json(200, { ...grupo, casas: comCasa ? [{ id: "c1", nome: "Casa sintética" }] : [] });
    if (url === "/api/espacos/g1/resumo/") return json(200, resumo);
    if (url.includes("/lancamentos/")) return json(200, { ...lista, mes: new URL(url, "http://localhost").searchParams.get("mes") ?? "2026-11" });
    return json(200, []);
  }));
}
test("COR-07: grupo com conta sem casa oferece caminho para listar contas", async () => {
  respostas();
  renderComSessao(<GrupoPagina id="g1" />);
  await screen.findByText("Nenhuma casa ainda.");
  expect(screen.queryAllByRole("link").some(a => a.getAttribute("href")?.startsWith("/contas"))).toBe(true);
});
test("COR-07: clicar no card de casa navega para contas", async () => {
  respostas(true);
  renderComSessao(<GrupoPagina id="g1" />);
  fireEvent.click(await screen.findByRole("button", { name: /Casa sintética/ }));
  // Actual result today: opens the edit dialog instead of a bill list.
  expect(await screen.findByRole("dialog", { name: "Editar casa" })).toBeTruthy();
  expect(router.push).toHaveBeenCalled();
});
test("COR-07: filtro de casa continua removível em mês sem opções", async () => {
  busca = "mes=2026-12&casa=c1";
  respostas();
  renderComSessao(<ContasPagina />);
  await screen.findByText("Nenhuma conta com esses filtros.");
  expect(screen.queryByRole("button", { name: "Filtros" })).not.toBeNull();
});
