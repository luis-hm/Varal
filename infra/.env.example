# Copie para infra/.env (o `make dev` faz isso). Valores abaixo são só para desenvolvimento local.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

# Authentication uses the web origin; Google's OAuth callback stays on the API origin.
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
# Google callback: http://localhost:8000/accounts/google/login/callback/
# Authorized JavaScript origin: http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local password-reset e-mails appear in the worker logs. Configure SMTP outside local dev.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Varal <nao-responda@varal.local>

# Push is opt-in; never put real keys in this example or publish them in logs.
# The private VAPID key from infra/.env is passed only to the worker container.
WEBPUSH_ENABLED=0
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=
# Exact homologated hostnames, comma-separated. Empty disables all providers.
WEBPUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
WEBPUSH_TIMEOUT_SECONDS=10
# Fernet key for encrypted push subscriptions; shared by API and worker.
# In local DEBUG the backend may derive a development key from DJANGO_SECRET_KEY.
NOTIFICACOES_STORAGE_KEY=

POSTGRES_DB=varal
POSTGRES_USER=varal
POSTGRES_PASSWORD=varal-dev
POSTGRES_HOST=postgres

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=varal
MINIO_ROOT_PASSWORD=varal-dev-minio

# Development only: blank AWS credentials fall back to MINIO_ROOT_* when DEBUG is on.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=varal-pdfs
S3_REGION_NAME=us-east-1
# Compose supplies these URL defaults for older .env files and fixes the shared staging path.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
PDF_SPOOL_DIR=/varal/staging

SEED_PASSWORD=varal-dev
