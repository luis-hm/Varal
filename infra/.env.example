# Copie para infra/.env (o `make dev` faz isso). Valores abaixo são só para desenvolvimento local.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Varal <nao-responda@varal.local>


WEBPUSH_ENABLED=0
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=
WEBPUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
WEBPUSH_TIMEOUT_SECONDS=10

NOTIFICACOES_STORAGE_KEY=

POSTGRES_DB=varal
POSTGRES_USER=varal
POSTGRES_PASSWORD=varal-dev
POSTGRES_HOST=postgres

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=varal
MINIO_ROOT_PASSWORD=varal-dev-minio

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=varal-pdfs
S3_REGION_NAME=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
PDF_SPOOL_DIR=/varal/staging

# Optional inventory for the remote Silo configured in Coolify.
# These variables do not change the local Django storage configuration.
# Map them explicitly to S3_*/AWS_* only in the future production deployment.
SILO_PROD_ENDPOINT_URL=
SILO_PROD_BUCKET_NAME=
SILO_PROD_REGION_NAME=
SILO_PROD_ACCESS_KEY_ID=
SILO_PROD_SECRET_ACCESS_KEY=

# Recovery administrator configuration, separate from application runtime.
# Leave empty locally unless the remote Silo recovery is being administered.
SILO_BACKUP_ADMIN_USER=
SILO_BACKUP_ADMIN_PASSWORD=

SEED_PASSWORD=varal-dev
COOLIFY_DEPLOY_HMG_TOKEN=
COOLIFY_DEPLOY_PROD_TOKEN=