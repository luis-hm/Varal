# Deployment template only. Supply secrets in Coolify; never commit a populated copy.
# HMG uses develop; production uses main and must remain stopped until explicitly enabled.
VARAL_STACK=hmgvaral
VARAL_DOMAIN=hmgvaral.codehub.systems
VARAL_APPLICATION_SUBNET=172.30.210.0/24
VARAL_FRONTEND_SUBNET=172.30.212.0/24
VARAL_EDGE_IP=172.30.210.2
VARAL_SSR_IP=172.30.210.3
VARAL_WEB_IP=172.30.212.10
# Docker DNS resolves this exact trusted proxy at nginx startup; reload edge if its IP changes.
# An explicit IPv4/32 or IPv6/128 is also accepted. Broad CIDRs/other hostnames are refused.
COOLIFY_PROXY_TRUST=coolify-proxy
DJANGO_SECRET_KEY=
POSTGRES_DB=varal_hmg
POSTGRES_ADMIN_USER=varal_hmg_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_USER=varal_hmg
POSTGRES_PASSWORD=
POSTGRES_MIGRATE_USER=varal_hmg_migrate
POSTGRES_MIGRATE_PASSWORD=
# A new UUID for this stack; retain it and the capability volumes across deployments.
JOURNAL_EPOCH=
S3_ENDPOINT_URL=https://arquivos.codehub.systems
S3_PUBLIC_ENDPOINT_URL=https://arquivos.codehub.systems
S3_BUCKET_NAME=varal-hmg-arquivos
S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NOTIFICACOES_STORAGE_KEY=
# OAuth callback: https://hmgvaral.codehub.systems/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Missing SMTP fails without claiming successful delivery; never use console or dummy.
EMAIL_HOST=127.0.0.1
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Varal <nao-responda@codehub.systems>
WEBPUSH_ENABLED=0
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=
