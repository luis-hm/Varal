worker_processes 1;
error_log /dev/null crit;
pid /tmp/nginx.pid;
events { worker_connections 512; }
http {
    map $upstream_http_referrer_policy $varal_referrer { "" no-referrer; default $upstream_http_referrer_policy; }
    access_log off;
    client_body_temp_path /tmp/client;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    server_tokens off;
    client_max_body_size 6m;
    set_real_ip_from ${COOLIFY_PROXY_TRUST};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    server { listen 8080 default_server; server_name _; return 421; }
    server {
        listen 8080;
        server_name ${VARAL_DOMAIN};
        # COR-12: the app (Next) owns the policy per page; the edge only fills the default.
        proxy_hide_header Referrer-Policy;
        add_header Referrer-Policy $varal_referrer always;
        proxy_set_header Host ${VARAL_DOMAIN};
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host ${VARAL_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        location /api/ { proxy_pass http://${VARAL_STACK}-api:8000; }
        location /accounts/ { proxy_pass http://${VARAL_STACK}-api:8000; }
        location / { proxy_pass http://${VARAL_STACK}-web:3000; }
    }
}
